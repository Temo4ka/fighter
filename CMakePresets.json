{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "debug",
      "displayName": "Debug: debug visualization, asserts, sanitizers",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "FIGHTER_DEBUG": "ON",
        "FIGHTER_SANITIZE": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release: optimized, no debug code",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "FIGHTER_DEBUG": "OFF",
        "FIGHTER_SANITIZE": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",   "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ],
  "testPresets": [
    { "name": "debug",   "configurePreset": "debug",   "output": { "outputOnFailure": true } },
    { "name": "release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug-fast", "configurePreset": "debug", "output": { "outputOnFailure": true },
      "filter": { "exclude": { "label": "slow" } } }
  ]
}
